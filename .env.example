# ==============================================================================
# Spillburg Logistics 1 (Private) Limited — Environment Configuration Template
# Copy this file to .env in your root hosting directory and update credentials.
# ==============================================================================

# Application Environment (production | development | staging)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://www.spillburglogistics1.com

# Database Connection Settings
# Options: mysql (recommended for cPanel / live production) or sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spillburg_logistics1
DB_USERNAME=spillburg_user
DB_PASSWORD=your_secure_db_password_here

# Operational Email Routing
# Where completed RFQ dockets and contact inquiries should be dispatched
SITE_CONTACT_EMAIL=info@spillburglogistics1.com
QUOTE_NOTIFICATIONS_EMAIL=info@spillburglogistics1.com

# SMTP Settings for PHP Mailer / cPanel SMTP (optional)
# If unconfigured, the system uses standard PHP mail() with error logging
SMTP_HOST=mail.spillburglogistics1.com
SMTP_PORT=465
SMTP_USER=info@spillburglogistics1.com
SMTP_PASS=your_email_password
SMTP_SECURE=ssl
